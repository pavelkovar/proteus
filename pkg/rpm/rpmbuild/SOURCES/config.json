{
  "listen": ["0.0.0.0:8080"],
  "status": { "listen": "127.0.0.1:8081" },
  "routes": [
    {
      "action": "static",
      "root": "/var/www/html",
      "fallback": {
        "action": "php",
        "target": "app"
      }
    }
  ],
  "php": {
    "targets": {
      "app": {
        "root": "/var/www/html",
        "script": "index.php"
      }
    },
    "limits": { "requests": 500, "timeout": 30 },
    "processes": { "max": 20, "spare": 4 }
  }
}
